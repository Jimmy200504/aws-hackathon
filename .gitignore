.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage

# Local JavaScript dependencies.
node_modules/

# Organizer-provided data must not be published.
data/dataset/*.csv
docs/*.pdf
# Verbatim job-seeker search strings; rebuild with scripts/build_top_queries.py
# and scripts/build_query_intents.py.
config/top-queries.json
config/query-intents.json
# Per-job view/apply aggregates; rebuild with scripts/build_job_behavior.py.
artifacts/job-behavior.json
docs/Supported AWS Services List*.csv

# Rebuildable / potentially sensitive evaluation material.
artifacts/benchmark-index.json
artifacts/temporal-eval.json
artifacts/ltr/
artifacts/quality/
artifacts/bedrock-pilot/
artifacts/quality-v2/
artifacts/skill-graph-canary/
artifacts/skill-graph-full/
artifacts/skill-graph-review/
artifacts/skill-graph-full-v2/extraction/
artifacts/skill-graph-full-v2/relations/
artifacts/skill-graph-full-v2/resolved/
artifacts/skill-graph-full-v2/pipeline-state.json
artifacts/skill-graph-full-v2/release/runs/*/*/edges/
artifacts/skill-graph-full-v2/release/runs/*/*/extraction/
artifacts/skill-graph-full-v2/release/runs/*/*/neptune/
artifacts/skill-graph-full-v2/release/runs/*/*/nodes/
artifacts/skill-graph-full-v2/release/runs/*/*/review/
artifacts/models/*
!artifacts/models/ltr-graph-final.ubj
!artifacts/models/ltr-graph-final.manifest.json
!artifacts/models/ltr-quality-final.ubj
!artifacts/models/ltr-quality-final.manifest.json
!artifacts/models/ltr-quality-final.trees.json
!artifacts/models/ltr-quality-remote-salary.ubj
!artifacts/models/ltr-quality-remote-salary.manifest.json
!artifacts/models/ltr-quality-remote-salary-intent.ubj
!artifacts/models/ltr-quality-remote-salary-intent.manifest.json
!artifacts/models/ltr-quality-remote-salary-intent.trees.json
!artifacts/models/ltr-quality-remote-salary.trees.json

# Local model-selection traces are retained for diagnosis, not submitted as
# authoritative evidence. Locked confirmations are tracked explicitly.
reports/ltr-tuning-*.json

# Local and deployment state.
.env
.aws-sam/
cdk.out/
dist/
snapshots/
*.log

# Throwaway resume helper generated during an interrupted index run.
RESUME-INDEX.sh
.agents/

# Internal development notes; not part of the judged submission.
notes/

# Derived from organizer search logs; deployed separately as an online cache.
config/query-intents.json
artifacts/exp-intent/
artifacts/exp-full/
