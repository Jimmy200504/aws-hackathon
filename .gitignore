.DS_Store
__pycache__/
*.py[cod]
.venv/
.venv-ltr/
.pytest_cache/
.coverage

# Organizer-provided data must not be published.
data/dataset/*.csv
docs/*.pdf

# Organizer-provided competition briefs, rules, and service allowlists.
hackathon_docs/

# Rebuildable / potentially sensitive evaluation material.
artifacts/benchmark-index.json
artifacts/temporal-eval.json
# 43 MB of per-posting district resolutions, rebuilt in ~75s by
# scripts/extract_job_districts.py. The aggregate evidence and every surface
# verdict live in reports/job-district-extraction.json, which is tracked.
artifacts/job-districts.json
artifacts/job-districts.jsonl
artifacts/job-districts-llm.json
artifacts/skill_ontology.seed_plus_llm.json
artifacts/llm-exp-smoke/
artifacts/llm-exp/
artifacts/ltr/
artifacts/quality/
artifacts/bedrock-pilot/
artifacts/models/*
!artifacts/models/ltr-graph-final.ubj
!artifacts/models/ltr-graph-final.manifest.json
!artifacts/models/ltr-quality-final.ubj
!artifacts/models/ltr-quality-final.manifest.json
!artifacts/models/ltr-quality-final.trees.json

# Local model-selection traces are retained for diagnosis, not submitted as
# authoritative evidence. Locked confirmations are tracked explicitly.
reports/ltr-tuning-*.json

# Local and deployment state.
.env
.aws-sam/
cdk.out/
dist/
*.log
