  "selection_split": "2026-06-06",
  "confirmation_split": {
    "date": "2026-06-07",
    "hash_bucket_start": 400,
    "hash_bucket_end_exclusive": 1400,
    "queries": 1993
  },
  "confidence_gate": "behavior_job_edge",
  "selection_forbidden_on_confirmation": true
