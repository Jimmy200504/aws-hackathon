{
  "framework": "SageMaker AI XGBoost",
  "framework_version": "3.0-5",
  "objective": "rank:ndcg",
  "eval_metric": "ndcg@10",
  "random_seed": 1111,
  "selected_hyperparameters": {
    "n_estimators": 20,
    "max_depth": 2,
    "learning_rate": 0.1,
    "min_child_weight": 8,
    "subsample": 0.8,
    "colsample_bytree": 0.82
  },
